    "findings": [
      {
        "finding": "The paper identifies sur as bcr and explicitly cites Swiss-Prot P28246, while reporting differences from the older sequence. Current sequence version 4 is not an experimental allele assignment.",
        "location": "Results, Characterization of sur"
      },
      {
        "finding": "Background-dependent contributions are reported for folP and sur/bcr; a single determinant does not account for the complete laboratory phenotype.",
        "location": "Results and Table 2"
      },
      {
        "finding": "sux remains a distinct unresolved modifier in this paper. The current bcr synonym suxA does not establish identity with sux.",
        "location": "Results, Characterization of sux; Discussion"
      },
      {
        "finding": "Figure 1 measures enzyme inhibition, not MIC. Table 2 contains whole-cell MICs in ug/mL; no values are imported or inferred from the plot.",
        "location": "Figure 1 and Table 2"
      }
