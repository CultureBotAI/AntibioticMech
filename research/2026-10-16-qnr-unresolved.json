      },
      "qnrb65": {
        "assessment": "No new primary results were obtained. The existing R4NN96 name candidate remains unselected; a protein submission name does not supply its missing native gene field or identify a measured allele.",
        "doi": "10.1128/AAC.01849-13",
        "locator": "Earlier pinned protein-name assessment; current publisher open returned web internal error without HTTP status",
        "medium": "INHERITED_CITATION_IDENTITY_NEW_OPEN_UNAVAILABLE",
