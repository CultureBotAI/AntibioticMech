      },
      "qnre1": {
        "assessment": "The paper identifies qnrE1 in Klebsiella pneumoniae Q1130 and separately reports laboratory-host results. KY073238 is the deposited region, not an assembly or BioSample. Other Enterobacter chromosomal matches are proposed source context, not interchangeable experimental subjects. No clinical category is newly derived.",
        "deposition_accession": "KY073238",
        "deposition_is_genome_assembly": false,
        "doi": "10.1128/AAC.02555-16",
        "heterologous_host_results_are_separate": true,
