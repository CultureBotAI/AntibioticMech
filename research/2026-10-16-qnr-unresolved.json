        "reference": "PMID:28193666",
        "source_isolate_label": "Q1130",
        "source_organism": "Klebsiella pneumoniae",
        "url": "https://journals.asm.org/doi/10.1128/aac.02555-16"
      },
      "qnrs12": {
        "assessment": "This is an analysis of database nomenclature and sequence-identification errors, not an allele-specific susceptibility experiment. The exact QnrS12 row and deposition crosswalk remain unreviewed; the title is not evidence that QnrS12 itself is erroneous.",
        "doi": "10.1093/jac/dky025",
        "locator": "Abstract and Introduction; detailed allele rows not obtained",
        "medium": "PUBLISHER_ABSTRACT_AND_STUDY_DESIGN_TEXT",
        "reference": "PMID:29415140",
        "url": "https://academic.oup.com/jac/article/73/5/1213/4837263"
      },
      "qnrvc-naming": {
        "assessment": "The two terms cite the same correspondence. Publisher bibliography and a citation pointer do not resolve their allele-specific results. Neither its title nor the shared PMID proves equivalent biological subjects.",
