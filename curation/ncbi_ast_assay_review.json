  "candidate_sha256": "456c68b9ca0885e0a2d9895327edc10734ea7ac0480a9f935d8757deedfe456b",
  "rationales": {
    "sensititre_mic": {
      "decision": "ACCEPT",
      "explanation": "Reported Sensititre/TREK platform supports MIC measurements. Raw reagent labels are retained, not promoted to verified panel identities.",
      "references": [
        "https://www.thermofisher.com/us/en/home/clinical/clinical-microbiology/antimicrobial-susceptibility-testing/resources.html",
        "https://www.trekds.com/pdf/TRK_catalog.pdf"
      ]
    },
    "sensititer_alias": {
      "decision": "ACCEPT",
      "explanation": "Curator interprets Sensititer as a spelling variant of Sensititre in this snapshot; the original label remains unchanged. This is a method-family interpretation, not a chemical identity mapping.",
      "references": [
        "https://www.thermofisher.com/us/en/home/clinical/clinical-microbiology/antimicrobial-susceptibility-testing/resources.html",
        "https://www.ncbi.nlm.nih.gov/pathogens/docs/ast/"
      ]
    },
    "microscan_mic": {
      "decision": "ACCEPT",
      "explanation": "Reported MicroScan platform supports MIC testing and 96-well panels; Siemens is a documented historical MicroScan vendor. No result or breakpoint is independently verified.",
      "references": [
        "https://media.beckmancoulter.com/en/products/microbiology/microscan-walkaway-plus-system",
        "https://www.beckmancoulter.com/en/about-beckman-coulter/newsroom/press-releases/2014/siemens-healthcare-diagnostics-microbiology-acquisition"
      ]
    },
    "phoenix_mic": {
      "decision": "ACCEPT",
      "explanation": "Reported Phoenix platform supports MIC testing. No specific unrecognized reagent code is promoted to a verified panel identity.",
      "references": [
        "https://www.bd.com/en-ca/products-and-solutions/products/product-families/bd-phoenix-panels"
      ]
    },
    "vitek_mic": {
      "decision": "ACCEPT",
      "explanation": "Reported Vitek platform family supports MIC measurements. Raw card labels remain submitter assertions, not independently certified panel identities.",
      "references": [
        "https://www.biomerieux.com/us/en/our-offer/clinical-products/vitek-2.html"
      ]
    },
    "explicit_dilution": {
      "decision": "ACCEPT",
      "explanation": "Source explicitly names agar dilution or broth microdilution alongside a MIC. Retain the submitted measurement without inventing protocol parameters.",
      "references": [
        "https://www.ncbi.nlm.nih.gov/pathogens/docs/ast/"
      ]
    },
    "explicit_disk": {
      "decision": "ACCEPT",
      "explanation": "Source explicitly names disk diffusion or an antibiotic disk and supplies a disk-zone measurement. Preserve the submitted interpretation without recalculating breakpoints.",
      "references": [
        "https://www.ncbi.nlm.nih.gov/pathogens/docs/ast/"
      ]
    },
    "scan_disk": {
      "decision": "ACCEPT",
      "explanation": "The named Scan 500 instrument reads inhibition zones; the source also explicitly identifies disk diffusion.",
      "references": [
        "https://www.interscience.com/en/products/inhibition-zone-readers/scan-500?lang=en"
      ]
    },
    "etest_mic": {
      "decision": "ACCEPT",
      "explanation": "The reported E-Test/ETEST reagent or platform supplies a gradient MIC, not a disk diameter.",
      "references": [
        "https://www.biomerieux.com/corp/en/our-offer/clinical-products/etest.html"
      ]
    },
    "measurement_conflict": {
      "decision": "QUARANTINE",
      "explanation": "Measurement type and submitted assay context are unresolved: disk-zone results name MIC instruments, or a MIC names only an antibiotic disk. Do not infer a corrected value or assay.",
      "references": [
        "https://www.ncbi.nlm.nih.gov/pathogens/docs/ast/",
        "https://www.biomerieux.com/us/en/our-offer/clinical-products/vitek-2.html",
        "https://media.beckmancoulter.com/en/products/microbiology/microscan-walkaway-plus-system"
      ]
    },
    "mixed_assays": {
      "decision": "QUARANTINE",
      "explanation": "ETEST can supplement automated testing, but the record does not establish which assay produced this MIC. Conflicting platform/reagent or vendor fields remain unresolved; no method is selected by inference.",
      "references": [
        "https://www.biomerieux.com/corp/en/our-offer/clinical-products/etest.html",
        "https://www.ncbi.nlm.nih.gov/pathogens/docs/ast/"
      ]
    },
    "panel_format_conflict": {
      "decision": "QUARANTINE",
      "explanation": "The submitted 96-Well Plate conflicts with documented VITEK 2 card or Phoenix panel formats. Quarantine pending source-level adjudication rather than rewriting the reagent or assuming the instrument version.",
      "references": [
        "https://www.biomerieux.com/us/en/our-offer/clinical-products/vitek-2.html",
        "https://www.accessdata.fda.gov/cdrh_docs/pdf12/K123266.pdf"
      ]
    },
    "vendor_conflict": {
      "decision": "QUARANTINE",
      "explanation": "Submitted Vitek platform with Trek vendor leaves instrument identity unresolved; neither field is silently overridden.",
      "references": [
        "https://www.biomerieux.com/us/en/our-offer/clinical-products/vitek-2.html",
        "https://www.trekds.com/pdf/TRK_catalog.pdf"
      ]
    },
    "ambiguous_kb": {
      "decision": "QUARANTINE",
      "explanation": "KB panel is an unexpanded source abbreviation. Do not assume a particular disk method until original submitter evidence establishes its meaning.",
      "references": [
        "https://www.ncbi.nlm.nih.gov/pathogens/docs/ast/"
      ]
    }
  },
